# ════════════════════════════════════════════════════════════════════════════════
# GAMMERS ADDA - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ════════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git - keep it secret!

# ── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-CHANGE-THIS-TO-RANDOM-50-CHAR-STRING
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ── Database (SQLite default, upgrade to PostgreSQL in production) ───────────
# For SQLite (development):
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# For PostgreSQL (production):
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=gammers_adda_db
# DATABASE_USER=your_db_user
# DATABASE_PASSWORD=your_db_password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# ── Email Configuration (Gmail SMTP) ─────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Gammers Adda <noreply@gamersadda.com>

# Owner notification email (receives booking alerts, login notifications)
OWNER_NOTIFICATION_EMAIL=Sammarvalkar343@gmail.com

# ── Razorpay Payment Gateway ─────────────────────────────────────────────────
# Test Keys (safe for development - never charge real money)
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET

# Live Keys (for production - real payments)
# RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET

# ── UPI Payment Details ──────────────────────────────────────────────────────
UPI_ID=your-upi-id@bank
UPI_NAME=Your Business Name
UPI_PHONE=+918355923184

# ── Business Settings ────────────────────────────────────────────────────────
BUSINESS_NAME=Gammers Adda
BUSINESS_PHONE=+918355923184
BUSINESS_EMAIL=info@gamersadda.com
BUSINESS_ADDRESS=Kopar Khairane, Navi Mumbai, Maharashtra

# ── Session & Security ───────────────────────────────────────────────────────
SEAT_HOLD_DURATION_MINUTES=10
DEFAULT_TAX_PERCENTAGE=18.0
SESSION_COOKIE_AGE=86400

# ── Optional: Third-party APIs ───────────────────────────────────────────────
# IGDB_CLIENT_ID=your_igdb_client_id
# IGDB_CLIENT_SECRET=your_igdb_client_secret
