# ══════════════════════════════════════════════════════════════════════════════
# GAMMERS ADDA - PRODUCTION ENVIRONMENT VARIABLES
# ══════════════════════════════════════════════════════════════════════════════
# 
# INSTRUCTIONS:
# 1. Copy these variables to your hosting platform's environment settings
# 2. Replace all placeholder values with your actual production credentials
# 3. NEVER commit this file with real values to git!
# 
# ══════════════════════════════════════════════════════════════════════════════

# ── Django Core Settings ──────────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_50_CHARACTER_STRING
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database Settings ─────────────────────────────────────────────────────────
# For SQLite (simple, good for small sites):
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# For PostgreSQL (recommended for production):
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=gammers_adda_db
# DATABASE_USER=postgres_user
# DATABASE_PASSWORD=postgres_password
# DATABASE_HOST=db.example.com
# DATABASE_PORT=5432

# ── Email Settings (Gmail SMTP) ───────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-business-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Gammers Adda <noreply@gamersadda.com>
OWNER_NOTIFICATION_EMAIL=owner-email@gmail.com

# ── Razorpay Payment Gateway (LIVE KEYS) ──────────────────────────────────────
# Replace with LIVE keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET

# ── UPI Payment Details ───────────────────────────────────────────────────────
UPI_ID=yourbusiness@paytm
UPI_NAME=Gammers Adda
UPI_PHONE=+919876543210

# ── Business Information ──────────────────────────────────────────────────────
BUSINESS_NAME=Gammers Adda
BUSINESS_PHONE=+919876543210
BUSINESS_EMAIL=info@gamersadda.com
BUSINESS_ADDRESS=Your Business Address, City, State, PIN

# ── Application Settings ──────────────────────────────────────────────────────
SEAT_HOLD_DURATION_MINUTES=10
DEFAULT_TAX_PERCENTAGE=18.0

# ── Security Settings ─────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True

# ══════════════════════════════════════════════════════════════════════════════
# END OF PRODUCTION CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
